# Copy to .env and fill in your values. .env is gitignored — never commit it.
#
# Vehicle profile (see README "Поддерживаемые автомобили"):
#   8nrfts = Toyota C-HR NGX10 1.2T (default, road-verified)
#   2zrfe  = Toyota 1.8 NA 2ZR-FE (Corolla/Auris)
#   2zrfxe = Toyota 1.8 Hybrid 2ZR-FXE (telemetry only)
#   generic = any OBD-II gasoline car (standard PIDs only)
#MYCAR_PROFILE=8nrfts
#
# macOS BLE UUID of your ELM327 dongle. Find it in System Settings -> Bluetooth
# (or via a BLE scan). Optional: if unset, the tool auto-scans for any OBD
# adapter advertising service FFF0/18F0.
MYCAR_BLE_ADDRESS=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
#
# Classic Bluetooth pairing PIN of the dongle (cheap clones: usually 1234).
# Note: on macOS the SPP profile of cheap clones is broken — use BLE, not SPP.
MYCAR_BT_PIN=1234
